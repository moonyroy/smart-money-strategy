//@version=6
indicator("❤️🍭🐰", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

pivotPeriod = input.int(5, "Pivot Period", minval = 1, maxval = 4999, tooltip = "Structure uses finalized Zig Zag pivots. A signal is drawn on its original break candle once the required pivots are final.")
const int closesRequired = 3
startTime = input.time(0, "Start Date", tooltip = "Zig Zag, structure and drawings start from this date onward. Default (1970) means the very first candle of the chart.")
lineStyleStr = input.string("Solid", "Line Style", options = ["Solid", "Dotted", "Dashed"])
lineColor = input.color(#2484bb, "Line Color")
lineWidth = input.int(1, "Line Width", minval = 1)
showBmsBox = input.bool(true, "Show BMS Boxes")
showFvg = input.bool(true, "Show FVGs", tooltip = "Shows same-direction three-candle gaps inside the time span and price bounds of the structure box.")
boxOnChoch = input.bool(false, "Also draw boxes on CHoCH")
boxZone = input.string("Up to 50%", "Box Height", options = ["Up to 50%", "Full range (0 - 1)"], tooltip = "Up to 50%: bullish box covers point 1 to the 0.5 level (Discount), bearish box covers the 0.5 level to point 1 (Premium).")
boxBars = input.int(20, "Box Length (candles)", minval = 1, maxval = 500, tooltip = "Number of candles the box extends after the break.")
zigzagStyle = lineStyleStr == "Dotted" ? line.style_dotted : lineStyleStr == "Dashed" ? line.style_dashed : line.style_solid

color lightBlue = color.rgb(100, 200, 255)
color pink = color.rgb(255, 105, 180)

max_bars_back(close, 5000)
max_bars_back(time, 5000)
const int maxDrawingOffset = 4999

type ZigzagPivot
    float price
    int tm
    int index
    bool isHigh
    float correctionStart
    string kind = ""

type StructureCandle
    int index
    int tm
    float highPrice
    float lowPrice
    float closePrice

selectZigzagPivot(ZigzagPivot tail, ZigzagPivot rawHigh, ZigzagPivot rawLow, bool hp, bool lp, float candleClose) =>
    ZigzagPivot selected = na
    bool replaceTail = false
    if na(tail)
        if hp != lp
            selected := hp ? rawHigh : rawLow
    else
        float lastValue = tail.price
        bool lastLow = tail.kind == "L" or tail.kind == "LL"
        bool lastHigh = tail.kind == "H" or tail.kind == "HH"
        bool lastLH = tail.kind == "LH"
        bool lastHL = tail.kind == "HL"

        if hp and lp
            if lastLow
                replaceTail := rawLow.price < lastValue
                selected := replaceTail ? rawLow : rawHigh
            else if lastHigh
                replaceTail := rawHigh.price > lastValue
                selected := replaceTail ? rawHigh : rawLow
            else if lastLH
                if rawHigh.price < lastValue
                    selected := rawLow
                else if rawHigh.price > lastValue
                    if candleClose < lastValue
                        replaceTail := true
                        selected := rawHigh
                    else if candleClose > lastValue
                        selected := rawLow
            else if lastHL
                if rawLow.price > lastValue
                    selected := rawHigh
                else if rawLow.price < lastValue
                    if candleClose > lastValue
                        replaceTail := true
                        selected := rawLow
                    else if candleClose < lastValue
                        selected := rawHigh
        else if hp
            if not tail.isHigh
                if rawHigh.price > lastValue
                    selected := rawHigh
                else if rawHigh.price < lastValue
                    replaceTail := true
                    selected := rawLow
            else if rawHigh.price > lastValue
                replaceTail := true
                selected := rawHigh
        else if lp
            if tail.isHigh
                if rawLow.price < lastValue
                    selected := rawLow
                else if rawLow.price > lastValue
                    replaceTail := true
                    selected := rawHigh
            else if rawLow.price < lastValue
                replaceTail := true
                selected := rawLow

    [selected, replaceTail]

appendZigzagPivot(array<ZigzagPivot> pivots, ZigzagPivot selected) =>
    int cnt = pivots.size()
    string kind = selected.isHigh ? "H" : "L"
    if cnt > 2
        ZigzagPivot previous = pivots.get(cnt - 2)
        if selected.isHigh
            kind := previous.price < selected.price ? "HH" : "LH"
        else
            kind := previous.price < selected.price ? "HL" : "LL"
    ZigzagPivot pivot = ZigzagPivot.new(selected.price, selected.tm, selected.index, selected.isHigh, selected.correctionStart, kind)
    pivots.push(pivot)

    if pivots.size() > 4
        pivots.shift()
    pivot

float pivotHighPrice = ta.pivothigh(pivotPeriod, pivotPeriod)
float pivotLowPrice = ta.pivotlow(pivotPeriod, pivotPeriod)
var ZigzagPivot rawHigh = na
var ZigzagPivot rawLow = na
var array<ZigzagPivot> zigzagPivots = array.new<ZigzagPivot>()
var line zigzagLine = na
var array<StructureCandle> pendingCandles = array.new<StructureCandle>()
var int pendingHead = 0

type Correction
    float threshold = na
    int closeCount = 0
    bool legEnded = false

method observe(Correction correction, float candleClose, float wick, bool upward) =>
    if not correction.legEnded and not na(correction.threshold) and correction.closeCount < closesRequired
        bool closedBeyond = upward ? candleClose > correction.threshold : candleClose < correction.threshold
        bool wickedBeyond = upward ? wick > correction.threshold : wick < correction.threshold
        if closedBeyond
            correction.closeCount += 1
        else if wickedBeyond
            correction.threshold := wick
    correction.closeCount

var array<float> loP = array.new<float>()
var array<int> loT = array.new<int>()
var array<int> loB = array.new<int>()
var array<float> hiP = array.new<float>()
var array<int> hiT = array.new<int>()
var array<int> hiB = array.new<int>()

pushPivot(array<float> prices, array<int> times, array<int> bars, float price, int tm, int bi) =>
    prices.push(price)
    times.push(tm)
    bars.push(bi)
    if prices.size() > 300
        prices.shift()
        times.shift()
        bars.shift()


pickProtected(bool lowSide, int fromBar, int toBar) =>
    array<float> p = loP
    array<int> t = loT
    array<int> b = loB
    if not lowSide
        p := hiP
        t := hiT
        b := hiB
    float rp = na
    int rt = na
    int rb = na
    int sz = p.size()
    if sz > 0
        for i = 0 to sz - 1
            int pb = b.get(i)
            if pb > fromBar and pb < toBar
                float pp = p.get(i)
                bool take = na(rp) or (lowSide ? pp < rp : pp > rp)
                if take
                    rp := pp
                    rt := t.get(i)
                    rb := pb
    [rp, rt, rb]

var float swingHigh = na
var int swingHighTime = na
var int swingHighBar = na
var float swingLow = na
var int swingLowTime = na
var int swingLowBar = na
var float previousSwingHigh = na
var float previousSwingLow = na

var float windowHigh = na
var int windowHighTime = na
var int windowHighBar = na
var float windowLow = na
var int windowLowTime = na
var int windowLowBar = na

var float lowSinceWindowHigh = na
var int lowSinceWindowHighTime = na
var int lowSinceWindowHighBar = na
var float highSinceWindowLow = na
var int highSinceWindowLowTime = na
var int highSinceWindowLowBar = na

var int direction = 0
var array<box> bgBoxes = array.new<box>()
var box activeBgBox = na
var float allHi = na
var float allLo = na
// The first bar at/after the start date acts as bar zero of the chart.
var int startIdx = na
if na(startIdx) and time >= startTime
    startIdx := bar_index
bool started = not na(startIdx)
if started
    allHi := na(allHi) ? high : math.max(allHi, high)
    allLo := na(allLo) ? low : math.min(allLo, low)
var int nextReferenceFrom = 0
var float protectedPrice = na
var int protectedTime = na
var int protectedBar = na
var Correction highCorrection = Correction.new()
var Correction lowCorrection = Correction.new()

type BmsBreak
    float wickLevel = na
    float referencePrice = na
    int referenceTime = na
    int referenceBar = na

method confirm(BmsBreak bms, bool upward, bool crossed, bool correctionReady, float wick, float candleClose, float referencePrice, int referenceTime, int referenceBar) =>
    bool confirmed = false
    if not na(bms.wickLevel)
        confirmed := correctionReady and (upward ? candleClose > bms.wickLevel : candleClose < bms.wickLevel)
        if not confirmed
            bms.wickLevel := upward ? math.max(bms.wickLevel, wick) : math.min(bms.wickLevel, wick)
    else if crossed and correctionReady
        bms.referencePrice := referencePrice
        bms.referenceTime := referenceTime
        bms.referenceBar := referenceBar
        confirmed := upward ? candleClose > referencePrice : candleClose < referencePrice
        if not confirmed
            bms.wickLevel := wick
    confirmed

var BmsBreak bullishBms = BmsBreak.new()
var BmsBreak bearishBms = BmsBreak.new()

// ---- Premium / Discount range (0 / 0.5 / 1) ----
var float rangeHigh = na
var float rangeLow = na
var int legOriginBar = na
var int legExtremeBar = na
var StructureCandle previousCandle = na
var StructureCandle firstCandle = na
var box lastBmsBox = na
var bool rangeFrozen = false

type Fvg
    int firstBar
    float top
    float bottom
    bool bullish

var array<Fvg> fvgCandidates = array.new<Fvg>()

drawLegFvgs(array<Fvg> candidates, int dir, int originBar, int extremeBar, int breakBar, float hi, float lo) =>
    if showFvg and dir != 0 and not na(originBar) and not na(extremeBar) and not na(hi) and not na(lo) and candidates.size() > 0
        float mid = (hi + lo) / 2
        float boxTop = boxZone == "Up to 50%" and dir == 1 ? mid : hi
        float boxBottom = boxZone == "Up to 50%" and dir == -1 ? mid : lo
        int leftBar = math.max(originBar, bar_index - maxDrawingOffset)
        int rightBar = math.min(breakBar + boxBars, bar_index + 500)
        int lastPatternBar = math.min(extremeBar, rightBar)
        for i = candidates.size() - 1 to 0
            Fvg gap = candidates.get(i)
            if gap.firstBar < leftBar
                break
            bool withinBoxPrice = gap.bottom >= boxBottom and gap.top <= boxTop
            bool matchesLegDirection = gap.bullish == (dir == 1)
            if matchesLegDirection and gap.firstBar + 2 <= lastPatternBar and withinBoxPrice
                color gapColor = gap.bullish ? color.teal : color.red
                box.new(gap.firstBar, gap.top, rightBar, gap.bottom, xloc = xloc.bar_index, border_color = color.new(gapColor, 55), bgcolor = color.new(gapColor, 91), text = "FVG", text_color = gapColor, text_size = size.tiny)
    0

int sourceIndex = bar_index - pivotPeriod
int sourceTime = time[pivotPeriod]
float sourceHigh = high[pivotPeriod]
float sourceLow = low[pivotPeriod]
float sourceClose = close[pivotPeriod]
// A pivot is valid only if its full left window (pivotPeriod bars) also starts at/after the start bar,
// exactly as if the chart's first candle were the start date.
bool pivotWindowOk = started and (sourceIndex - pivotPeriod >= startIdx)
bool candleOk = started and (sourceIndex >= startIdx)
bool hp = not na(pivotHighPrice) and pivotWindowOk
bool lp = not na(pivotLowPrice) and pivotWindowOk
ZigzagPivot tail = zigzagPivots.size() > 0 ? zigzagPivots.last() : na
ZigzagPivot finalizedPivot = na

if hp or lp
    if hp
        rawHigh := ZigzagPivot.new(pivotHighPrice, sourceTime, sourceIndex, true, sourceLow)
    if lp
        rawLow := ZigzagPivot.new(pivotLowPrice, sourceTime, sourceIndex, false, sourceHigh)

    [selected, replaceTail] = selectZigzagPivot(tail, rawHigh, rawLow, hp, lp, close)
    if not na(selected)
        if replaceTail
            zigzagPivots.pop()
        else
            finalizedPivot := tail
        tail := appendZigzagPivot(zigzagPivots, selected)

        int zzCount = zigzagPivots.size()
        if zzCount >= 2
            ZigzagPivot previous = zigzagPivots.get(zzCount - 2)
            bool useBarIndex = bar_index - previous.index <= maxDrawingOffset
            string drawingXloc = useBarIndex ? xloc.bar_index : xloc.bar_time
            int startX = useBarIndex ? previous.index : previous.tm
            int endX = useBarIndex ? tail.index : tail.tm
            if replaceTail and not na(zigzagLine)
                line.set_xloc(zigzagLine, startX, endX, drawingXloc)
                line.set_y2(zigzagLine, tail.price)
            else
                zigzagLine := line.new(startX, previous.price, endX, tail.price, xloc = drawingXloc, color = lineColor, style = zigzagStyle, width = lineWidth)

if barstate.isconfirmed and not na(tail) and candleOk
    pendingCandles.push(StructureCandle.new(sourceIndex, sourceTime, sourceHigh, sourceLow, sourceClose))

    
    while pendingHead < pendingCandles.size()
        StructureCandle candle = pendingCandles.get(pendingHead)
        if candle.index > tail.index
            break
        int structureBar = candle.index
        int structureTime = candle.tm
        float structureHigh = candle.highPrice
        float structureLow = candle.lowPrice
        float structureClose = candle.closePrice
        if not na(firstCandle) and not na(previousCandle)
            bool consecutive = firstCandle.index + 2 == structureBar and previousCandle.index + 1 == structureBar
            bool bullishGap = structureLow > firstCandle.highPrice
            bool bearishGap = structureHigh < firstCandle.lowPrice
            if showFvg and consecutive and (bullishGap or bearishGap)
                float gapTop = bullishGap ? structureLow : firstCandle.lowPrice
                float gapBottom = bullishGap ? firstCandle.highPrice : structureHigh
                fvgCandidates.push(Fvg.new(firstCandle.index, gapTop, gapBottom, bullishGap))
                if fvgCandidates.size() > maxDrawingOffset + 1
                    fvgCandidates.shift()
        firstCandle := previousCandle
        previousCandle := candle

        bool useWindowReference = direction != 0

        // A pivot on the break candle itself is eligible on the next candle.
        if not na(finalizedPivot) and finalizedPivot.index < structureBar
            float pivotHigh = finalizedPivot.isHigh ? finalizedPivot.price : na
            float pivotLow = finalizedPivot.isHigh ? na : finalizedPivot.price
            int pivotTime = finalizedPivot.tm
            int pivotBar = finalizedPivot.index
            float correctionStart = finalizedPivot.correctionStart
            finalizedPivot := na
            if not na(pivotHigh)
                pushPivot(hiP, hiT, hiB, pivotHigh, pivotTime, pivotBar)
            else
                pushPivot(loP, loT, loB, pivotLow, pivotTime, pivotBar)

            if pivotBar >= nextReferenceFrom
                // First pullback pivot after the event freezes point 0 of the range
                if (na(pivotHigh) and direction == 1) or (not na(pivotHigh) and direction == -1)
                    if not rangeFrozen
                        drawLegFvgs(fvgCandidates, direction, legOriginBar, legExtremeBar, nextReferenceFrom, rangeHigh, rangeLow)
                    rangeFrozen := true
                // This pivot has already been observed as a candle. Its close can count,
                // but candles after it belong to a different leg.
                if not na(pivotHigh)
                    if not na(lowCorrection.threshold)
                        lowCorrection.legEnded := true
                else if not na(highCorrection.threshold)
                    highCorrection.legEnded := true

                if not na(pivotHigh)
                    // FIX: move the window to a higher pivot in any direction, unless a wick-only BMS is already pending
                    bool newWindowHigh = na(windowHigh) or (pivotHigh > windowHigh and na(bullishBms.wickLevel))
                    if newWindowHigh
                        windowHigh := pivotHigh
                        windowHighTime := pivotTime
                        windowHighBar := pivotBar
                        lowSinceWindowHigh := na
                    swingHigh := pivotHigh
                    swingHighTime := pivotTime
                    swingHighBar := pivotBar
                    previousSwingHigh := hiP.size() > 1 ? hiP.get(hiP.size() - 2) : na
                    if direction >= 0 and na(bullishBms.wickLevel) and (not useWindowReference or newWindowHigh)
                        highCorrection := Correction.new(correctionStart)
                else
                    // FIX: mirror for the low side
                    bool newWindowLow = na(windowLow) or (pivotLow < windowLow and na(bearishBms.wickLevel))
                    if newWindowLow
                        windowLow := pivotLow
                        windowLowTime := pivotTime
                        windowLowBar := pivotBar
                        highSinceWindowLow := na
                    swingLow := pivotLow
                    swingLowTime := pivotTime
                    swingLowBar := pivotBar
                    previousSwingLow := loP.size() > 1 ? loP.get(loP.size() - 2) : na
                    if direction <= 0 and na(bearishBms.wickLevel) and (not useWindowReference or newWindowLow)
                        lowCorrection := Correction.new(correctionStart)

        bool highReady = highCorrection.legEnded and highCorrection.closeCount >= closesRequired
        bool lowReady = lowCorrection.legEnded and lowCorrection.closeCount >= closesRequired
        float bmsHigh = useWindowReference ? windowHigh : swingHigh
        float bmsLow = useWindowReference ? windowLow : swingLow
        int bmsHighBar = useWindowReference ? windowHighBar : swingHighBar
        int bmsLowBar = useWindowReference ? windowLowBar : swingLowBar
        int bmsHighTime = useWindowReference ? windowHighTime : swingHighTime
        int bmsLowTime = useWindowReference ? windowLowTime : swingLowTime

        float highPullbackReference = na(protectedPrice) ? previousSwingHigh : protectedPrice
        float lowPullbackReference = na(protectedPrice) ? previousSwingLow : protectedPrice
        bool hasLowerHigh = not na(swingHigh) and not na(bmsLowBar) and swingHighBar > bmsLowBar and not na(highPullbackReference) and swingHigh < highPullbackReference
        bool hasHigherLow = not na(swingLow) and not na(bmsHighBar) and swingLowBar > bmsHighBar and not na(lowPullbackReference) and swingLow > lowPullbackReference

        bool bullishContinuation = direction == 1 and hasHigherLow and structureHigh > bmsHigh
        bool bearishContinuation = direction == -1 and hasLowerHigh and structureLow < bmsLow
        bool highBroken = not na(bmsHigh) and (direction == 0 ? structureHigh > bmsHigh : bullishContinuation)
        bool lowBroken = not na(bmsLow) and (direction == 0 ? structureLow < bmsLow : bearishContinuation)
        bool bearishChange = direction == 1 and not na(protectedPrice) and structureLow <= protectedPrice
        bool bullishChange = direction == -1 and not na(protectedPrice) and structureHigh >= protectedPrice
        bool isChange = bearishChange or bullishChange

        highCorrection.observe(structureClose, structureLow, false)
        lowCorrection.observe(structureClose, structureHigh, true)

        int eventDirection = 0
        if isChange
            eventDirection := -direction
        else
            bool bullishConfirmed = bullishBms.confirm(true, highBroken, highReady, structureHigh, structureClose, bmsHigh, bmsHighTime, bmsHighBar)
            bool bearishConfirmed = bearishBms.confirm(false, lowBroken, lowReady, structureLow, structureClose, bmsLow, bmsLowTime, bmsLowBar)
            if bullishConfirmed != bearishConfirmed
                eventDirection := bullishConfirmed ? 1 : -1

        if eventDirection != 0
            bool bullish = eventDirection == 1
            BmsBreak bms = bullish ? bullishBms : bearishBms
            float levelPrice = isChange ? protectedPrice : nz(bms.wickLevel, bms.referencePrice)
            int levelTime = isChange ? protectedTime : bms.referenceTime
            int levelBar = isChange ? protectedBar : bms.referenceBar
            color eventColor = isChange ? pink : lightBlue

            int spanBars = bar_index - levelBar
            bool useBarIndex = structureBar - levelBar >= 8 and spanBars <= maxDrawingOffset
            string drawingXloc = useBarIndex ? xloc.bar_index : xloc.bar_time
            int startX = useBarIndex ? levelBar : levelTime
            int endX = useBarIndex ? structureBar : structureTime
            int spanX = endX - startX
            int centerX = startX + int(spanX * 0.5)
            int halfGap = math.max(1, int(spanX * 0.05))

            line.new(startX, levelPrice, centerX - halfGap, levelPrice, xloc = drawingXloc, color = eventColor)
            line.new(centerX + halfGap, levelPrice, endX, levelPrice, xloc = drawingXloc, color = eventColor)
            label.new(centerX, levelPrice, isChange ? "CHoCH" : "BMS", xloc = drawingXloc, yloc = yloc.price, style = label.style_label_center, color = color.new(eventColor, 100), textcolor = eventColor, size = size.small)

            float originPrice = na
            int originTime = na
            int originBar = na
            bool isContinuation = not isChange and useWindowReference
            if isContinuation
                originPrice := bullish ? lowSinceWindowHigh : highSinceWindowLow
                originTime := bullish ? lowSinceWindowHighTime : highSinceWindowLowTime
                originBar := bullish ? lowSinceWindowHighBar : highSinceWindowLowBar
            else
                [pickPrice, pickTime, pickBar] = pickProtected(bullish, levelBar, structureBar)
                originPrice := pickPrice
                originTime := pickTime
                originBar := pickBar
            bool hasOrigin = not na(originPrice) and originBar > levelBar and originBar < structureBar
            if hasOrigin
                protectedPrice := originPrice
                protectedTime := originTime
                protectedBar := originBar
            else if isChange
                protectedPrice := na
                protectedTime := na
                protectedBar := na

            if not rangeFrozen
                drawLegFvgs(fvgCandidates, direction, legOriginBar, legExtremeBar, nextReferenceFrom, rangeHigh, rangeLow)
            legOriginBar := hasOrigin and (not isChange or boxOnChoch) ? originBar : na
            legExtremeBar := not na(legOriginBar) ? structureBar : na

            // Range: point 1 = protected origin (fixed), point 0 = live extreme
            if hasOrigin
                if bullish
                    rangeLow := originPrice
                    rangeHigh := math.max(structureHigh, levelPrice)
                else
                    rangeHigh := originPrice
                    rangeLow := math.min(structureLow, levelPrice)
            else
                rangeHigh := na
                rangeLow := na

            // BMS box: from the range origin (point 1) to the high/low of the move, extended per input
            lastBmsBox := na
            rangeFrozen := false
            if showBmsBox and hasOrigin and (not isChange or boxOnChoch)
                int boxLeft = math.max(originBar, bar_index - maxDrawingOffset)
                int boxRight = math.min(structureBar + boxBars, bar_index + 500)
                float rangeMid = (rangeHigh + rangeLow) / 2
                float boxTop = boxZone == "Up to 50%" and bullish ? rangeMid : rangeHigh
                float boxBottom = boxZone == "Up to 50%" and not bullish ? rangeMid : rangeLow
                box newBox = box.new(boxLeft, boxTop, boxRight, boxBottom, xloc = xloc.bar_index, border_color = color.new(eventColor, 40), bgcolor = color.new(eventColor, 85))
                lastBmsBox := newBox

            // Background: close the previous box and open a new one on the real event candle
            if eventDirection != direction
                if not na(activeBgBox)
                    box.set_right(activeBgBox, structureTime)
                activeBgBox := box.new(structureTime, allHi, structureTime, allLo, xloc = xloc.bar_time, border_color = color.new(color.white, 100), bgcolor = color.new(eventDirection == 1 ? lightBlue : pink, 90))
                bgBoxes.push(activeBgBox)
                if bgBoxes.size() > 500
                    bgBoxes.shift()

            direction := eventDirection
            nextReferenceFrom := structureBar
            swingHigh := na
            swingLow := na
            previousSwingHigh := na
            previousSwingLow := na
            windowHigh := na
            windowLow := na
            windowHighBar := na
            windowLowBar := na
            lowSinceWindowHigh := na
            highSinceWindowLow := na
            highCorrection := Correction.new()
            lowCorrection := Correction.new()
            bullishBms := BmsBreak.new()
            bearishBms := BmsBreak.new()
        else
            if not na(windowHigh) and (na(lowSinceWindowHigh) or structureLow < lowSinceWindowHigh)
                lowSinceWindowHigh := structureLow
                lowSinceWindowHighTime := structureTime
                lowSinceWindowHighBar := structureBar
            if not na(windowLow) and (na(highSinceWindowLow) or structureHigh > highSinceWindowLow)
                highSinceWindowLow := structureHigh
                highSinceWindowLowTime := structureTime
                highSinceWindowLowBar := structureBar

            // Track point 0 even when the range box is hidden.
            if not rangeFrozen and not na(rangeHigh) and not na(rangeLow)
                if direction == 1 and structureHigh > rangeHigh
                    rangeHigh := structureHigh
                    if not na(legOriginBar)
                        legExtremeBar := structureBar
                    if not na(lastBmsBox)
                        box.set_top(lastBmsBox, boxZone == "Up to 50%" ? (rangeHigh + rangeLow) / 2 : rangeHigh)
                if direction == -1 and structureLow < rangeLow
                    rangeLow := structureLow
                    if not na(legOriginBar)
                        legExtremeBar := structureBar
                    if not na(lastBmsBox)
                        box.set_bottom(lastBmsBox, boxZone == "Up to 50%" ? (rangeHigh + rangeLow) / 2 : rangeLow)

        pendingHead += 1

    if pendingHead == pendingCandles.size()
        pendingCandles.clear()
        pendingHead := 0
    else if pendingHead >= 512 and pendingHead * 2 >= pendingCandles.size()
        pendingCandles := array.copy(array.slice(pendingCandles, pendingHead, pendingCandles.size()))
        pendingHead := 0

if barstate.islast
    if not na(activeBgBox)
        box.set_right(activeBgBox, time)
    for b in bgBoxes
        box.set_top(b, allHi)
        box.set_bottom(b, allLo)
